# Copy to .env and fill in. .env is gitignored.
PORT=3000
# Origin allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Postgres connection string.
# Local Supabase (`pnpm db:start`): the value below.
# Supabase cloud: Project → Connect → "Session pooler" string (port 5432), with your
# database password in place of [YOUR-PASSWORD]. It works over IPv4 (the "Direct
# connection" string is IPv6-only) and also works for `supabase db push --db-url`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

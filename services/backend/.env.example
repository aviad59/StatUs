# Copy to .env and fill in. .env is gitignored.
PORT=3000
# Origin allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Postgres connection string.
# Local Supabase (`pnpm db:start`): the value below.
# Supabase cloud: Project → Connect → "Session pooler" string (port 5432), with your
# database password in place of [YOUR-PASSWORD]. It works over IPv4 (the "Direct
# connection" string is IPv6-only) and also works for `supabase db push --db-url`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# AI providers (src/ai/). Text = posts/comments/DMs; decision = typed choices.
#   AI_TEXT_PROVIDER:     ollama | anthropic
#   AI_DECISION_PROVIDER: ollama | anthropic | jev
AI_TEXT_PROVIDER=ollama
AI_DECISION_PROVIDER=ollama

# Ollama (local): https://ollama.com. Pull the model first: `ollama pull qwen3:8b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Anthropic Claude: key from https://console.anthropic.com (billed per token)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# TypeSafe Jev (decisions only, early access): key from https://typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1
